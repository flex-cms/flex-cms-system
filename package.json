{
    "name": "flex-cms",
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite --port 3000",
        "build": "vite build",
        "preview": "vite preview",
        "migrate": "php vendor/bin/phinx migrate",
        "rollback": "php vendor/bin/phinx rollback",
        "migrate:create": "php vendor/bin/phinx create",
        "migrate:status": "php vendor/bin/phinx status",
        "seed": "php vendor/bin/phinx seed:run -s DatabaseSeeder",
        "dev:all": "concurrently \"php -S localhost:8000\" \"npm run dev\" \"cd themes/Basic && npm run dev\"",
        "format": "prettier . --write --ignore-unknown",
        "format:check": "prettier . --check --ignore-unknown"
    },
    "dependencies": {
        "@alpinejs/collapse": "^3.15.12",
        "@fortawesome/fontawesome-free": "^7.2.0",
        "@hotwired/turbo": "^8.0.23",
        "ace-builds": "^1.44.0",
        "alpinejs": "^3.14.0",
        "axios": "^1.16.1",
        "dayjs": "^1.11.21",
        "flatpickr": "^4.6.13",
        "jquery": "^4.0.0",
        "lit": "^3.3.3",
        "moment": "^2.30.1",
        "sortablejs": "^1.15.7",
        "sweetalert2": "^11.26.25",
        "tailwindcss": "^4.0.0",
        "tom-select": "^2.6.1"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.0",
        "concurrently": "^10.0.3",
        "prettier": "^3.9.6",
        "vite": "^6.0.0"
    }
}
