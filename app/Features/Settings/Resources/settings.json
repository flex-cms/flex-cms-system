{
    "group": "general",
    "sources": {
        "languages": {
            "bg": "Български",
            "en": "English"
        },
        "date_formats": {
            "d.m.Y": "31.12.2026",
            "d/m/Y": "31/12/2026",
            "Y-m-d": "2026-12-31",
            "m/d/Y": "12/31/2026"
        }
    },
    "pages": {
        "general": {
            "label": "Общи настройки",
            "description": "Основни настройки на Flex CMS.",
            "icon": "fa-solid fa-gear",
            "url": "/admin/settings/general",
            "fields": {
                "site_name": {
                    "component": "input",
                    "type": "string",
                    "label": "Име на сайта",
                    "default": "Flex CMS",
                    "placeholder": "Flex CMS",
                    "icon": "fa-solid fa-globe",
                    "validation": {
                        "required": true,
                        "maxLength": 255
                    }
                },
                "admin_email": {
                    "component": "input",
                    "type": "email",
                    "label": "Административен имейл",
                    "default": "",
                    "placeholder": "admin@example.com",
                    "icon": "fa-solid fa-envelope",
                    "validation": {
                        "required": true,
                        "maxLength": 255
                    }
                },
                "site_url": {
                    "component": "input",
                    "type": "url",
                    "label": "URL адрес",
                    "default": "",
                    "placeholder": "https://example.com",
                    "icon": "fa-solid fa-link",
                    "validation": {
                        "maxLength": 2048
                    }
                },
                "site_description": {
                    "component": "input",
                    "type": "textarea",
                    "label": "Кратко описание",
                    "default": "",
                    "placeholder": "Кратко описание на сайта",
                    "rows": 5,
                    "fullWidth": true,
                    "validation": {
                        "maxLength": 500
                    }
                },
                "timezone": {
                    "component": "dropdown",
                    "type": "string",
                    "label": "Часова зона",
                    "default": "Europe/Sofia",
                    "optionsSource": "timezones",
                    "validation": {
                        "required": true
                    }
                },
                "date_format": {
                    "component": "dropdown",
                    "type": "string",
                    "label": "Формат на датата",
                    "default": "d.m.Y",
                    "optionsSource": "date_formats",
                    "validation": {
                        "required": true
                    }
                },
                "debug_mode": {
                    "component": "checkbox",
                    "type": "boolean",
                    "label": "Debug режим",
                    "helper": "Използвай само за разработка. При production трябва да бъде изключен.",
                    "default": false,
                    "value": "1",
                    "fullWidth": true
                },
                "enable_multilang": {
                    "component": "checkbox",
                    "type": "boolean",
                    "label": "Активиране на многоезичност",
                    "helper": "Позволява на сайта да използва множество езици.",
                    "default": false,
                    "value": "1",
                    "fullWidth": true
                },
                "site_default_lang": {
                    "component": "dropdown",
                    "type": "string",
                    "label": "Език на сайта по подразбиране",
                    "default": "bg",
                    "optionsSource": "languages",
                    "validation": {
                        "required": true
                    }
                },
                "admin_default_lang": {
                    "component": "dropdown",
                    "type": "string",
                    "label": "Език на админ панела",
                    "default": "bg",
                    "optionsSource": "languages",
                    "validation": {
                        "required": true
                    }
                }
            }
        },
        "mail": {
            "label": "Имейл",
            "description": "Настройки за изпращане на системни имейли.",
            "icon": "fa-solid fa-envelope",
            "url": "/admin/settings/mail",
            "fields": {
                "smtp_host": {
                    "component": "input",
                    "type": "string",
                    "label": "SMTP хост",
                    "default": "",
                    "placeholder": "mail.example.com",
                    "icon": "fa-solid fa-server",
                    "validation": {
                        "maxLength": 255
                    }
                },
                "smtp_port": {
                    "component": "input",
                    "type": "integer",
                    "label": "SMTP порт",
                    "default": 587,
                    "placeholder": "587",
                    "validation": {
                        "min": 1,
                        "max": 65535
                    }
                },
                "smtp_user": {
                    "component": "input",
                    "type": "string",
                    "label": "SMTP потребител",
                    "default": "",
                    "placeholder": "user@example.com",
                    "icon": "fa-solid fa-user",
                    "validation": {
                        "maxLength": 255
                    }
                },
                "smtp_pass": {
                    "component": "input",
                    "type": "password",
                    "label": "SMTP парола",
                    "default": "",
                    "placeholder": "Въведете нова парола",
                    "icon": "fa-solid fa-lock",
                    "autocomplete": "new-password",
                    "preserveOnEmpty": true
                },
                "smtp_encryption": {
                    "component": "dropdown",
                    "type": "string",
                    "label": "Криптиране",
                    "default": "tls",
                    "options": {
                        "tls": "TLS",
                        "ssl": "SSL",
                        "none": "Без криптиране"
                    }
                },
                "from_email": {
                    "component": "input",
                    "type": "email",
                    "label": "Имейл на подателя",
                    "default": "",
                    "placeholder": "noreply@example.com",
                    "icon": "fa-solid fa-at",
                    "validation": {
                        "maxLength": 255
                    }
                }
            }
        },
        "media": {
            "label": "Медия",
            "description": "Настройки за качване и организация на файловете.",
            "icon": "fa-solid fa-images",
            "url": "/admin/settings/media",
            "fields": {
                "media_use_date_folders": {
                    "component": "checkbox",
                    "type": "boolean",
                    "label": "Подреждане в папки по дата",
                    "helper": "Автоматично организира качените файлове в папки според датата.",
                    "default": true,
                    "value": "1",
                    "fullWidth": true
                },
                "media_keep_original_name": {
                    "component": "checkbox",
                    "type": "boolean",
                    "label": "Запазване на оригиналното име",
                    "helper": "Запазва оригиналното име на файла при качване.",
                    "default": false,
                    "value": "1",
                    "fullWidth": true
                },
                "media_max_size": {
                    "component": "input",
                    "type": "integer",
                    "label": "Максимален размер",
                    "helper": "Максимален размер на един файл в MB.",
                    "default": 5,
                    "validation": {
                        "min": 1,
                        "max": 1024
                    }
                },
                "media_allowed_extensions": {
                    "component": "input",
                    "type": "string",
                    "label": "Разрешени разширения",
                    "default": "jpg,png,webp",
                    "placeholder": "jpg,png,webp,pdf",
                    "helper": "Разделяй разширенията със запетая.",
                    "fullWidth": true
                }
            }
        }
    }
}
