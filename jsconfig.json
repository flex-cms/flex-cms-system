{
    "compilerOptions": {
        "allowJs": true,
        "checkJs": false,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "paths": {
            "@/*": ["./resources/js/*"]
        }
    },
    "include": ["resources/js/**/*.js"],
    "exclude": ["node_modules", "public", "vendor"]
}
